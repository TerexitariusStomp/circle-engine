{
	"$schema": "https://design-tokens.github.io/community-group/format/",
	"$description": "CIC design tokens — ground truth extracted from the deployed app bundle (cic-app mirror, 0.B0NZKGKX.css) and the Figma design system. Three themes: mist (light), deep (dark), sand (warm).",
	"font": {
		"sans": { "$value": ["Lato", "ui-sans-serif", "system-ui", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "sans-serif"], "$type": "fontFamily" },
		"serif": { "$value": ["EB Garamond", "Georgia", "serif"], "$type": "fontFamily" },
		"display": { "$value": ["Caveat", "EB Garamond", "serif"], "$type": "fontFamily", "$description": "handwritten accents, marketing/entry surface" },
		"weight": {
			"medium": { "$value": 500, "$type": "fontWeight" },
			"semibold": { "$value": 600, "$type": "fontWeight" },
			"bold": { "$value": 700, "$type": "fontWeight" },
			"extrabold": { "$value": 800, "$type": "fontWeight" }
		}
	},
	"color": {
		"$type": "color",
		"accent": { "$value": "#1abc9c", "$description": "CIC teal — primary action, holder ring" },
		"accentDeep": { "$value": "#14342f" },
		"fire": { "$value": "#d9823f", "$description": "warning / recorder-live / credit-warning" },
		"fireDeep": { "$value": "#c05f2e" },
		"creditWarning": { "$value": "#f6b13e" },
		"danger": { "$value": "#c45a52" },
		"chalkWhite": { "$value": "#ecf0f1" },
		"theme": {
			"mist": {
				"bg": { "$value": "#f3f6f6" },
				"bgDeep": { "$value": "#ebf0f0" },
				"surface": { "$value": "#f7fafa" },
				"ink": { "$value": "#22323c" },
				"inkSoft": { "$value": "#51656f" },
				"line": { "$value": "#e1e8e9" },
				"lineSoft": { "$value": "#ede9e0" }
			},
			"deep": {
				"bg": { "$value": "#181d23" },
				"bgDeep": { "$value": "#13181d" },
				"surface": { "$value": "#1c232a" },
				"ink": { "$value": "#edf2f4" },
				"inkSoft": { "$value": "#bdcbd2" },
				"line": { "$value": "#34414b" },
				"lineSoft": { "$value": "#222930" }
			},
			"sand": {
				"bg": { "$value": "#f7f1e6" },
				"bgDeep": { "$value": "#f0e8d6" },
				"surface": { "$value": "#fffdf8" },
				"ink": { "$value": "#3b3127" },
				"inkSoft": { "$value": "#6b5d4a" },
				"line": { "$value": "#e8ddc9" },
				"lineSoft": { "$value": "#dcd6cb" }
			}
		}
	},
	"radius": {
		"$type": "dimension",
		"sm": { "$value": "12px" },
		"md": { "$value": "18px", "$description": "default card radius" },
		"xl": { "$value": "1.5rem" },
		"pill": { "$value": "999px" }
	},
	"shadow": {
		"$type": "shadow",
		"sm": { "$value": "0 1px 2px #48341e0d, 0 2px 8px #48341e0d" },
		"md": { "$value": "0 2px 6px #48341e0d, 0 10px 28px #48341e17" },
		"lg": { "$value": "0 4px 12px #3c2a1812, 0 24px 60px #3c2a1821" }
	},
	"ease": {
		"in": { "$value": "cubic-bezier(.4, 0, 1, 1)" },
		"out": { "$value": "cubic-bezier(0, 0, .2, 1)" },
		"inOut": { "$value": "cubic-bezier(.4, 0, .2, 1)" }
	}
}
